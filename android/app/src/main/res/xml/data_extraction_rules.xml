<?xml version="1.0" encoding="utf-8"?>
<!-- See backup_rules.xml - same exclusions for Android 12+ cloud backup
     and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
        <exclude domain="file" path="dr_brain.task"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
        <exclude domain="file" path="dr_brain.task"/>
    </device-transfer>
</data-extraction-rules>
